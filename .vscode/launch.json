{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to GKE Pod (Delve)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "localhost",
      "port": 2345,
      "apiVersion": 2,
      "showLog": true,
      "logOutput": "rpc",
      "trace": "verbose",
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "/app"
        }
      ]
    }
  ]
}