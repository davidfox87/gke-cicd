{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch server (cmd/server)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/server",
            "env": {},
            "args": [],
            "showLog": true
        },
        {
            "name": "Launch current file/package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": "${command:pickProcess}"
        }
    ],
    "compounds": []
}