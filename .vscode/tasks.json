{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: build current package",
            "type": "shell",
            "command": "go build -v",
            "group": "build",
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "go: build server",
            "type": "shell",
            "command": "go build -v -o server",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "go: test all",
            "type": "shell",
            "command": "go test -v -cover ./...",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$go"
            ]
        }
    ]
}